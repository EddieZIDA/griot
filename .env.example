# Copier ce fichier en ".env" et renseigner les valeurs.
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).

# Clé Gemini (obligatoire) : https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Optionnel : synchronisation de la base avec Hugging Face ---
# Jeton avec droit d'écriture : https://huggingface.co/settings/tokens
# HF_TOKEN=
# GRIOT_DB_REPO=votre-compte/griot-db
# GRIOT_SPACE_ID=votre-compte/griot

# --- Optionnel : réglages de l'application ---
# GRIOT_MULTI_USER=1                  # historique séparé par navigateur
# GRIOT_HOST=0.0.0.0                  # écouter sur le réseau
# GRIOT_PORT=7860
# GRIOT_MAX_MESSAGES_PER_SESSION=10   # 0 = illimité
# GRIOT_MAX_MESSAGES_PER_DAY=150      # 0 = illimité
